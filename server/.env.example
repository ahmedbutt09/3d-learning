# Reference list of environment variables. Locally none are required (defaults apply).
# In production, set them in the Render dashboard (or render.yaml).
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Leave DATABASE_URL empty to use a local SQLite file (server/data.db).
# Set it to a PostgreSQL URL in production (Render, Neon, Supabase, ...).
DATABASE_URL=

# First owner/admin account, created on first start if no admin exists
ADMIN_EMAIL=admin@3dlearning.com
ADMIN_PASSWORD=Admin@12345

# Set to false to skip the demo tutors and demo student
SEED_DEMO=true

# Comma-separated list of allowed front-end origins (needed when the React app is on Vercel)
CLIENT_ORIGIN=http://localhost:5173
